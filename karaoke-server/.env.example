# Copy to .env and edit for your machine. .env is gitignored.
# All settings are optional — every value below is the built-in default unless
# noted. Full reference: README.md ("Configuration").

# Bind address. Defaults to 127.0.0.1 (local only).
# Use 0.0.0.0 to expose the server to other devices on your LAN.
KARAOKE_HOST=127.0.0.1
KARAOKE_PORT=8787

# Database, song files and downloaded models.
# Default: ~/.local/share/karaoke-server
#KARAOKE_DATA_DIR=/path/to/karaoke/data

# UI origins allowed by CORS, comma-separated. The Vite dev server uses 5173.
# Add your LAN address here if you open the UI from another device, e.g.
# http://192.168.x.x:5173 — or use "*" to allow any origin.
KARAOKE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ML device: auto | cpu | cuda | mps. "auto" picks cuda > mps > cpu.
# Pin to cuda if you have an NVIDIA GPU and want a hard failure rather than a
# silent CPU fallback.
KARAOKE_DEVICE=auto

# Alignment model. Use small/medium on weak CPUs.
KARAOKE_WHISPER_MODEL=large-v3-turbo

# Vocal separation: fast (UVR MDX-NET) or quality (BS-Roformer).
KARAOKE_SEPARATION_PRESET=fast

# Allow ToS-gray lyric scrapers as a last resort.
KARAOKE_ENABLE_SCRAPING_PROVIDERS=false
